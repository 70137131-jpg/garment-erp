# Compose configuration. Copy to .env and fill in before `docker compose up`.

# Database credentials (the only strictly required value is the password).
POSTGRES_DB=garment_erp
POSTGRES_USER=garment_erp
POSTGRES_PASSWORD=

# First-run administrator. Remove both after first login; they are ignored
# once any user exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Port the SPA is served on for the local/evaluation stack.
HTTP_PORT=8080

# --- Capacity -------------------------------------------------------------
# Gunicorn worker processes. A sensible starting point is (2 × CPU cores),
# capped by the connection arithmetic below. More workers is not free: each one
# is a full copy of the app and holds its own database pool.
WEB_CONCURRENCY=4

# Per-worker SQLAlchemy pool. The cluster's peak demand on PostgreSQL is
#     WEB_CONCURRENCY × (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# With the defaults that is 4 × 15 = 60 connections. Keep it well under
# POSTGRES_MAX_CONNECTIONS so backups, psql and migrations can still connect.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Server-side ceiling. Each connection costs a few MB of RAM.
POSTGRES_MAX_CONNECTIONS=200
# Rule of thumb: ~25% of the machine's RAM.
POSTGRES_SHARED_BUFFERS=256MB

# Error tracking (optional).
SENTRY_DSN=

# Backups (compose "backup" service).
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# --- Production override (docker-compose.prod.yml) ---
# Public hostname; Caddy provisions HTTPS for it automatically.
DOMAIN=
