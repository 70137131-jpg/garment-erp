# Copy to .env and adjust. SQLite is the zero-setup default for local dev.
# For production use Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/garment_erp
# AUTO_CREATE_SCHEMA=false
DATABASE_URL=sqlite:///./garment_erp.db

# Set ENVIRONMENT=production to enable fail-fast validation of every production
# requirement below.
# ENVIRONMENT=production

# Required to create the first administrator in a fresh database. Remove these
# values after the first successful startup; they are ignored once users exist.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# File attachments: where uploaded files are stored, and the per-file limit.
# ATTACHMENTS_DIR=./attachments
# MAX_UPLOAD_BYTES=10485760

# Observability. Use json logs in containers; console is the dev default.
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# Error tracking (optional). Set the DSN from your Sentry project to enable.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Production hardening (HTTPS deployment):
# SESSION_COOKIE_SECURE=true
# ENABLE_API_DOCS=false
# SESSION_IDLE_MINUTES=30
# MAX_REQUEST_BODY_BYTES=2097152
# CORS_ORIGINS=https://erp.example.com
# ALLOWED_HOSTS=erp.example.com
# If TLS terminates at a reverse proxy, configure the ASGI server's trusted
# proxy/IP forwarding settings so login throttling receives the real client IP.
